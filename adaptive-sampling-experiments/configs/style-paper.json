{
  "_comment": "Styling for the manuscript figures (scripts/07_paper_figures.py). Colours follow the Okabe-Ito palette. 'label' is the legend text used in the paper; keys are policy names as in the result CSVs.",
  "rc": {
    "font.family": "serif",
    "font.serif": ["cmr10"],
    "mathtext.fontset": "cm",
    "axes.formatter.use_mathtext": true,
    "axes.unicode_minus": false,
    "font.size": 7,
    "axes.titlesize": 7,
    "axes.labelsize": 7,
    "xtick.labelsize": 6.5,
    "ytick.labelsize": 6.5,
    "legend.fontsize": 5.8,
    "legend.frameon": false,
    "legend.handlelength": 2.2,
    "legend.borderaxespad": 0.3,
    "legend.labelspacing": 0.25,
    "lines.linewidth": 1.1,
    "axes.linewidth": 0.6,
    "xtick.major.width": 0.6,
    "ytick.major.width": 0.6,
    "xtick.minor.width": 0.4,
    "ytick.minor.width": 0.4,
    "axes.grid": true,
    "grid.alpha": 0.25,
    "grid.linewidth": 0.4,
    "axes.spines.top": false,
    "axes.spines.right": false,
    "savefig.bbox": "tight",
    "savefig.pad_inches": 0.02,
    "pdf.fonttype": 42
  },
  "policies": {
    "ALG1":                {"label": "Algorithm 1",                  "color": "#000000", "lw": 1.7},
    "ALG2(beta=1)":        {"label": "Algorithm 2",                  "color": "#000000", "lw": 1.7},
    "ALG2(beta=0.3)":      {"label": "Algorithm 2, $\\beta=0.3$", "color": "#555555", "lw": 1.0, "ls": "--"},
    "ALG2(beta=0.1)":      {"label": "Algorithm 2, $\\beta=0.1$", "color": "#999999", "lw": 1.0, "ls": ":"},
    "ALG2(greedy)":        {"label": "Algorithm 2, $\\beta=0$", "color": "#CC79A7", "lw": 1.1, "ls": "-."},
    "ORACLE-CL":           {"label": "oracle closed loop",           "color": "#0072B2", "lw": 1.1},
    "ORACLE-OL":           {"label": "oracle open loop",             "color": "#009E73", "lw": 1.1, "ls": "--"},
    "ORACLE-OL-iid":       {"label": "oracle open loop (i.i.d.)",    "color": "#009E73", "lw": 0.8, "ls": ":"},
    "ORACLE-OL-mincost":   {"label": "oracle open loop, min-cost mix", "color": "#009E73", "lw": 1.1, "ls": "--"},
    "ETC(eps=0.1)":        {"label": "explore-then-commit ($T=10^5$)", "color": "#7F3C8D", "marker": "D", "ms": 3.2},
    "N1-CHEAPEST":         {"label": "online only",                  "color": "#E69F00", "lw": 1.1},
    "N1-EXPENSIVE":        {"label": "offline channel only",         "color": "#8C510A", "lw": 0.9, "ls": ":"},
    "N2-UNIFORM":          {"label": "uniform over channels",        "color": "#D55E00", "lw": 1.1},
    "N3-POOLPROP":         {"label": "pool-proportional",            "color": "#999999", "lw": 1.0}
  },
  "default_policy": {"color": "#333333", "lw": 1.0},
  "reference_lines": {"color": "#000000", "lw": 0.7},
  "sequence_palette": ["#000000", "#0072B2", "#009E73", "#E69F00", "#CC79A7", "#D55E00"]
}
